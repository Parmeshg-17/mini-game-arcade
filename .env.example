# ==============================================================================
# Mini Game Arcade — Google AdSense Environment Configuration Example
#
# This file documents the public environment variables used to configure Google
# AdSense placements across the Mini Game Arcade website.
#
# INSTRUCTIONS:
# 1. Obtain your Client ID from Google AdSense (e.g. ca-pub-6654460587836639).
# 2. In Google AdSense Dashboard, navigate to: Ads -> By ad unit -> Display ad.
# 3. Create 3 responsive display ad units:
#    - "Home Top Leaderboard"
#    - "Home Games Feed Banner"
#    - "Game Page Bottom Unit"
# 4. Copy each 10-digit Slot ID into the corresponding variable below or into
#    the centralized configuration file at `js/ads-config.js`.
# 5. Set ADSENSE_ENABLED=true once AdSense status shows "Ready" to serve ads.
# ==============================================================================

# Publisher Client ID (Public identifier, not a secret)
ADSENSE_CLIENT_ID=ca-pub-6654460587836639

# Master Switch: Set to true once approved by Google AdSense
ADSENSE_ENABLED=false

# Development Debug Mode: Shows subtle layout outlines on localhost only
ADSENSE_DEBUG=false

# Specific Ad Unit Slot IDs (10-digit numbers from AdSense console)
ADSENSE_HOME_TOP_SLOT=
ADSENSE_HOME_LIST_SLOT=
ADSENSE_GAME_BOTTOM_SLOT=
